# Copia este archivo como variables de entorno en Vercel
# (Project Settings → Environment Variables) — NUNCA subas la
# llave privada al repositorio ni la pongas en archivos públicos.

# Dashboard de Openpay > Llaves API
OPENPAY_MERCHANT_ID=tu_merchant_id
OPENPAY_PRIVATE_KEY=tu_llave_privada
# false = modo pruebas (sandbox), true = producción
OPENPAY_PRODUCTION=false

# Opcional: si no la defines, se arma sola a partir del dominio
# de la petición.
SITE_URL=https://www.ai-solutions4you.info

# Opcional pero recomendado: credenciales que configures también
# al crear el webhook en el Dashboard de Openpay (Basic Auth).
OPENPAY_WEBHOOK_USER=
OPENPAY_WEBHOOK_PASSWORD=
